/*
 * Wheel may administer units and disks, but not silently. AUTH_ADMIN_KEEP
 * requires a polkit admin authentication and then caches it. A compromised
 * user session must not format or repartition disks without that check.
 */
polkit.addRule(function(action, subject) {
    if (!subject.isInGroup("wheel")) {
        return polkit.Result.NOT_HANDLED;
    }

    if (action.id === "org.freedesktop.systemd1.manage-units" ||
        action.id.indexOf("org.freedesktop.udisks2.") === 0) {
        return polkit.Result.AUTH_ADMIN_KEEP;
    }

    return polkit.Result.NOT_HANDLED;
});
