#!/usr/bin/env bash
# Enter or initialize Doors' one declarative, GPU-aware AI Distrobox.
set -euo pipefail

readonly container='doors-ai'
readonly manifest='/usr/share/doors/distrobox/doors-ai.ini'

require_runtime() {
  command -v distrobox >/dev/null || { echo 'distrobox is unavailable' >&2; return 1; }
  command -v podman >/dev/null || { echo 'podman is unavailable' >&2; return 1; }
  [[ -r "${manifest}" ]] || { echo "missing Doors AI manifest: ${manifest}" >&2; return 1; }
}

existing_image() {
  podman container inspect --format '{{.Config.Image}}' "${container}" 2>/dev/null || true
}

bootstrap() {
  require_runtime

  local runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
  mkdir -p "${runtime_dir}"
  exec 9>"${runtime_dir}/doors-ai-distrobox.lock"
  flock -n 9 || return 0

  local image
  image="$(existing_image)"
  if [[ -n "${image}" && "${image}" != *archlinux* ]]; then
    cat >&2 <<'MESSAGE'
The existing doors-ai container predates the Arch Linux toolchain and is not
replaced automatically. Export any container-local work, then run:

  doors-ai recreate

That explicit command removes and recreates only the rootless doors-ai
container; it never layers AI tooling onto the host.
MESSAGE
    return 1
  fi

  if [[ -n "${image}" ]] && distrobox enter "${container}" -- true >/dev/null 2>&1; then
    return 0
  fi
  distrobox assemble create --file "${manifest}"
}

recreate() {
  require_runtime
  if [[ -n "$(existing_image)" ]]; then
    distrobox rm --force "${container}"
  fi
  bootstrap
}

usage() {
  cat >&2 <<'USAGE'
Usage: doors-ai bootstrap | recreate | shell | run <command> [args...]

`recreate` intentionally removes only the rootless doors-ai container before
rebuilding it from the current Arch Linux manifest.
USAGE
}

case "${1:-shell}" in
  bootstrap)
    bootstrap
    ;;
  recreate)
    recreate
    ;;
  shell)
    bootstrap
    exec distrobox enter "${container}"
    ;;
  run)
    shift
    [[ "$#" -gt 0 ]] || { usage; exit 2; }
    bootstrap
    exec distrobox enter "${container}" -- "$@"
    ;;
  *)
    usage
    exit 2
    ;;
esac
