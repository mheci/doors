#!/usr/bin/env bash
# Convenience entry point for Doors' development and AI toolchain.
# CUDA and the compilers are image commands. Node, pnpm, Bun, Deno, Zed, and
# the agent CLIs are per-user tools. Updating them does not rebuild the image.
set -euo pipefail

readonly -a image_tools=(mise nvcc ncu nsys)
readonly -a mise_tools=(node pnpm bun deno opencode pi codex herdr)

require_image_tools() {
  local tool
  for tool in "${image_tools[@]}"; do
    command -v "${tool}" >/dev/null 2>&1 || {
      printf 'doors-ai: missing image tool: %s\n' "${tool}" >&2
      return 1
    }
  done
}

mise_version() {
  mise ls --current --json 2>/dev/null \
    | jq -r --arg t "$1" 'to_entries[] | select(.key == $t) | .value[0].version // "?"' \
    | head -1
}

tool_status() {
  local tool="$1"
  local path
  if path="$(command -v "${tool}" 2>/dev/null)" && [[ "${path}" == *'/.local/share/mise/shims/'* ]]; then
    printf '%-12s %s\n' "${tool}" "$(mise_version "${tool}")"
  else
    printf '%-12s %s\n' "${tool}" 'not installed yet'
  fi
}

zed_status() {
  local launcher="${HOME}/.local/bin/zed"
  local version_file="${XDG_STATE_HOME:-${HOME}/.local/state}/doors/zed-version"
  if [[ -x "${launcher}" ]]; then
    if [[ -s "${version_file}" ]]; then
      tr -d '[:space:]' < "${version_file}"
      printf '\n'
    else
      printf 'installed\n'
    fi
  elif systemctl --user is-active --quiet doors-zed-install.service 2>/dev/null; then
    printf 'installing (journalctl --user -u doors-zed-install)\n'
  else
    printf 'not installed yet (systemctl --user start doors-zed-install)\n'
  fi
}

status() {
  local tool path
  require_image_tools
  printf '%-12s %s\n' 'tool' 'path'
  for tool in "${image_tools[@]}"; do
    path="$(command -v "${tool}")"
    printf '%-12s %s\n' "${tool}" "${path}"
  done
  printf 'cuda-home    %s\n' "${CUDA_HOME:-/usr/lib/doors/cuda-13.4}"
  printf '\n%-12s %s\n' 'user tool' 'installed version'
  for tool in "${mise_tools[@]}"; do
    tool_status "${tool}"
  done
  printf '%-12s %s' 'zed' "$(zed_status)"
  printf '\nPending updates: doors-update preview\n'
}

usage() {
  cat >&2 <<'USAGE'
Usage:
  doors-ai status
  doors-ai shell
  doors-ai run <command> [args...]

  doors-ai install     install tools declared in /etc/mise/config.toml
  doors-ai upgrade     upgrade those mise tools now

CUDA stays in the image. Node, pnpm, Bun, Deno, and the agent CLIs are
per-user mise tools. Zed is installed per account. The weekly
check is `doors-update preview`; it installs nothing until `doors-update apply`.
USAGE
}

case "${1:-status}" in
  status)
    [[ "$#" -eq 1 || "$#" -eq 0 ]] || { usage; exit 2; }
    status
    ;;
  shell)
    [[ "$#" -eq 1 ]] || { usage; exit 2; }
    require_image_tools
    exec /usr/bin/bash -l
    ;;
  run)
    shift
    [[ "$#" -gt 0 ]] || { usage; exit 2; }
    require_image_tools
    exec "$@"
    ;;
  install)
    [[ "$#" -eq 1 ]] || { usage; exit 2; }
    (( EUID != 0 )) || { printf 'doors-ai: mise tools are per-user; run install as your own account\n' >&2; exit 1; }
    exec /usr/bin/mise install
    ;;
  upgrade)
    [[ "$#" -eq 1 ]] || { usage; exit 2; }
    (( EUID != 0 )) || { printf 'doors-ai: mise tools are per-user; run upgrade as your own account\n' >&2; exit 1; }
    /usr/bin/mise install
    exec /usr/bin/mise upgrade
    ;;
  *)
    usage
    exit 2
    ;;
esac
