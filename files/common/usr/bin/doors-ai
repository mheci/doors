#!/usr/bin/env bash
# Convenience entry point for Doors' development and AI toolchain.
# Compilers, runtimes, CUDA, and mise are image-owned RPMs. The agent CLIs are
# per-user mise tools declared in /etc/mise/config.toml; no container is
# involved and no tool update requires an image rebuild.
set -euo pipefail

readonly -a native_tools=(bun deno mise ncu node npm nsys pnpm nvcc)
readonly -a mise_tools=(opencode pi codex herdr)

require_native_tools() {
  local tool
  for tool in "${native_tools[@]}"; do
    command -v "${tool}" >/dev/null 2>&1 || {
      printf 'doors-ai: missing native tool: %s\n' "${tool}" >&2
      return 1
    }
  done
}

# Installed version of one Doors-declared mise tool.
mise_version() {
  mise ls --current --json 2>/dev/null \
    | jq -r --arg t "$1" 'to_entries[] | select(.key == $t) | .value[0].version // "?"' \
    | head -1
}

status() {
  local tool path

  require_native_tools
  printf '%-12s %s\n' 'tool' 'path'
  for tool in "${native_tools[@]}"; do
    path="$(command -v "${tool}")"
    printf '%-12s %s\n' "${tool}" "${path}"
  done
  printf 'cuda-home    %s\n' "${CUDA_HOME:-/usr/lib/doors/cuda-13.4}"
  printf '\n%-12s %s\n' 'mise tool' 'installed version (run: doors-ai install / upgrade)'
  for tool in "${mise_tools[@]}"; do
    if path="$(command -v "${tool}" 2>/dev/null)" && [[ "${path}" == *"/.local/share/mise/shims/"* ]]; then
      printf '%-12s %s\n' "${tool}" "$(mise_version "${tool}")"
    else
      printf '%-12s %s\n' "${tool}" 'not installed yet'
    fi
  done
  printf '\n%-12s %s\n' 'hermes' "$(hermes_status)"
}

# Hermes Agent is installed per account by doors-hermes-install.service.
hermes_status() {
  local launcher="${HOME}/.local/bin/hermes"
  if [[ -x "${launcher}" ]]; then
    "${launcher}" --version 2>/dev/null | head -1 || printf 'installed'
  elif systemctl --user is-active --quiet doors-hermes-install.service 2>/dev/null; then
    printf 'installing (journalctl --user -u doors-hermes-install)'
  else
    printf 'not installed yet (systemctl --user start doors-hermes-install)'
  fi
}

usage() {
  cat >&2 <<'USAGE'
Usage:
  doors-ai status
  doors-ai shell
  doors-ai run <command> [args...]

  doors-ai install     install every tool declared in /etc/mise/config.toml
  doors-ai upgrade     upgrade those tools in place (no reboot, no rebase)

Compilers, runtimes, and CUDA are native image commands. OpenCode, Pi, Codex,
and Herdr are per-user mise tools on PATH via ~/.local/share/mise/shims.
Hermes Agent (hermes, hermes desktop) is installed per user by
doors-hermes-install.service. `run` executes directly on the host.
USAGE
}

case "${1:-status}" in
  status)
    [[ "$#" -eq 1 || "$#" -eq 0 ]] || { usage; exit 2; }
    status
    ;;
  shell)
    [[ "$#" -eq 1 ]] || { usage; exit 2; }
    require_native_tools
    exec /usr/bin/bash -l
    ;;
  run)
    shift
    [[ "$#" -gt 0 ]] || { usage; exit 2; }
    require_native_tools
    exec "$@"
    ;;
  install)
    [[ "$#" -eq 1 ]] || { usage; exit 2; }
    (( EUID != 0 )) || { printf 'doors-ai: mise tools are per-user; run install as your own account\n' >&2; exit 1; }
    exec /usr/bin/mise install
    ;;
  upgrade)
    [[ "$#" -eq 1 ]] || { usage; exit 2; }
    (( EUID != 0 )) || { printf 'doors-ai: mise tools are per-user; run upgrade as your own account\n' >&2; exit 1; }
    /usr/bin/mise install
    exec /usr/bin/mise upgrade
    ;;
  *)
    usage
    exit 2
    ;;
esac
