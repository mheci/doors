#!/usr/bin/env bash
# Reset only an allowlisted set of desktop-shell/theme state for a Doors image
# transition. Documents, Flatpaks, generic application configuration, and user
# data outside the listed paths are intentionally untouched.
set -Eeuo pipefail

readonly confirmation_phrase='CLEAN-DESKTOP-STATE'

usage() {
  cat <<'EOF'
Usage:
  doors-desktop-cleanup --all-users [--yes] [--dry-run]
  doors-desktop-cleanup --current-user [--yes] [--dry-run]

--all-users handles every regular local account with an interactive shell and
an existing home directory. Before removal, each account receives a private tar
backup under ~/.local/state/doors/desktop-switch-backups/.
EOF
}

die() {
  printf 'doors-desktop-cleanup: %s\n' "$*" >&2
  exit 1
}

is_interactive_shell() {
  case "$1" in
    ''|/sbin/nologin|/usr/sbin/nologin|/bin/false|/usr/bin/false) return 1 ;;
    *) return 0 ;;
  esac
}

uid_range() {
  local key default="$2" value
  value="$(awk -v key="${key}" '$1 == key { print $2; exit }' /etc/login.defs 2>/dev/null || true)"
  printf '%s\n' "${value:-${default}}"
}

regular_local_users() {
  local uid_min uid_max user _ uid _ _ home shell
  uid_min="$(uid_range UID_MIN 1000)"
  uid_max="$(uid_range UID_MAX 60000)"

  while IFS=: read -r user _ uid _ _ home shell; do
    [[ "${uid}" =~ ^[0-9]+$ ]] || continue
    (( uid >= uid_min && uid <= uid_max )) || continue
    is_interactive_shell "${shell}" || continue
    [[ "${home}" == /* && "${home}" != / && -d "${home}" ]] || continue
    printf '%s\t%s\n' "${user}" "${home}"
  done < /etc/passwd
}

confirm() {
  local assume_yes="$1"
  local answer
  [[ "${assume_yes}" == true ]] && return
  read -r -p "This resets allowlisted desktop theme/shell state and creates per-user backups. Type ${confirmation_phrase} to continue: " answer
  [[ "${answer}" == "${confirmation_phrase}" ]] || die 'confirmation did not match; no state was changed'
}

backup_and_clean_current_user() {
  local dry_run="$1"
  local home="${HOME:?HOME must be set}"
  local timestamp backup_dir archive rel
  local -a candidates existing

  [[ "${home}" == /* && "${home}" != / && -d "${home}" ]] \
    || die 'refusing to operate without a safe existing HOME directory'

  # Paths are deliberately narrow: desktop shell, theme, toolkit, and display
  # settings only. Keep application-specific KDE/GTK settings and all Flatpak
  # data intact.
  candidates=(
    '.config/dconf/user'
    '.config/kdeglobals'
    '.config/kwinrc'
    '.config/plasmarc'
    '.config/plasma-org.kde.plasma.desktop-appletsrc'
    '.config/kcminputrc'
    '.config/kglobalshortcutsrc'
    '.config/kactivitymanagerdrc'
    '.config/kscreenlockerrc'
    '.config/ksmserverrc'
    '.config/ksplashrc'
    '.config/gtk-3.0/settings.ini'
    '.config/gtk-4.0/settings.ini'
    '.config/qt5ct'
    '.config/qt6ct'
    '.config/xsettingsd'
    '.gtkrc-2.0'
  )

  existing=()
  for rel in "${candidates[@]}"; do
    if [[ -e "${home}/${rel}" || -L "${home}/${rel}" ]]; then
      existing+=("${rel}")
    fi
  done

  printf 'doors-desktop-cleanup: %s: %d allowlisted desktop path(s) selected\n' \
    "${USER:-$(id -un)}" "${#existing[@]}"
  if [[ "${dry_run}" == true ]]; then
    printf '  %s\n' "${existing[@]:-no existing allowlisted paths}"
    return
  fi

  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  backup_dir="${home}/.local/state/doors/desktop-switch-backups/${timestamp}"
  archive="${backup_dir}/desktop-state.tar"
  install -d -m 0700 "${backup_dir}"

  if (( ${#existing[@]} > 0 )); then
    tar --create --file="${archive}" --directory="${home}" -- "${existing[@]}"
    chmod 0600 "${archive}"
    printf 'doors-desktop-cleanup: backed up selected state to %s\n' "${archive}"
  fi

  # Reset only GNOME shell/desktop schema trees. This preserves unrelated dconf
  # application keys rather than deleting the user database wholesale.
  if command -v dconf >/dev/null 2>&1 && command -v dbus-run-session >/dev/null 2>&1; then
    dbus-run-session -- bash -eu -c '
      for prefix in \
        /org/gnome/desktop/interface/ \
        /org/gnome/desktop/background/ \
        /org/gnome/desktop/screensaver/ \
        /org/gnome/desktop/wm/ \
        /org/gnome/shell/ \
        /org/gnome/settings-daemon/; do
        dconf reset -f "$prefix" || true
      done
    '
  else
    printf '%s\n' 'doors-desktop-cleanup: dconf/dbus-run-session is unavailable; left GNOME dconf untouched rather than deleting unrelated application settings.' >&2
  fi

  # dconf's database is reset above, not removed. Remove only the explicitly
  # desktop-specific configuration paths after the backup has completed.
  for rel in \
    '.config/kdeglobals' \
    '.config/kwinrc' \
    '.config/plasmarc' \
    '.config/plasma-org.kde.plasma.desktop-appletsrc' \
    '.config/kcminputrc' \
    '.config/kglobalshortcutsrc' \
    '.config/kactivitymanagerdrc' \
    '.config/kscreenlockerrc' \
    '.config/ksmserverrc' \
    '.config/ksplashrc' \
    '.config/gtk-3.0/settings.ini' \
    '.config/gtk-4.0/settings.ini' \
    '.config/qt5ct' \
    '.config/qt6ct' \
    '.config/xsettingsd' \
    '.gtkrc-2.0'; do
    rm -rf -- "${home:?}/${rel:?}"
  done
}

main() {
  local scope='' assume_yes=false dry_run=false

  while (( $# > 0 )); do
    case "$1" in
      --all-users|--current-user)
        [[ -z "${scope}" ]] || die 'choose exactly one scope'
        scope="$1"
        ;;
      --yes)
        assume_yes=true
        ;;
      --dry-run)
        dry_run=true
        ;;
      -h|--help)
        usage
        return
        ;;
      *)
        usage >&2
        die "unknown option: $1"
        ;;
    esac
    shift
  done

  [[ -n "${scope}" ]] || { usage >&2; exit 2; }
  if [[ "${scope}" == '--all-users' ]]; then
    [[ "${EUID}" -eq 0 ]] || die '--all-users requires root'
  fi

  if [[ "${dry_run}" != true ]]; then
    confirm "${assume_yes}"
  fi

  case "${scope}" in
    --current-user)
      backup_and_clean_current_user "${dry_run}"
      ;;
    --all-users)
      local user home count=0
      local -a child_args=(--current-user --yes)
      if [[ "${dry_run}" == true ]]; then
        child_args+=(--dry-run)
      fi
      while IFS=$'\t' read -r user home; do
        ((count += 1))
        /usr/sbin/runuser -u "${user}" -- env \
          HOME="${home}" USER="${user}" LOGNAME="${user}" \
          /usr/bin/doors-desktop-cleanup "${child_args[@]}"
      done < <(regular_local_users)
      printf 'doors-desktop-cleanup: processed %d regular local account(s)\n' "${count}"
      ;;
  esac
}

main "$@"
