[Unit]
Description=Install Hermes Agent (CLI and desktop app) for this account
Documentation=https://github.com/mheci/doors https://hermes-agent.nousresearch.com/docs
ConditionUser=!@system
# Finished installs are skipped by the stamp. A failed first attempt retries
# on the next login; the weekly check does not install or upgrade Hermes.
ConditionPathExists=!%S/doors/hermes-installed

[Service]
Type=oneshot
ExecStart=/usr/libexec/doors/hermes-install.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h

[Install]
WantedBy=default.target
