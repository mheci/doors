[Unit]
Description=Install the Doors-declared mise tools for this account
Documentation=https://github.com/mheci/doors
ConditionPathExists=/etc/mise/config.toml
ConditionUser=!@system

[Service]
Type=oneshot
# Installs missing declared tools only. It does not upgrade tools that are
# already present; that waits for doors-update apply.
ExecStart=/usr/bin/mise install
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=60min

[Install]
WantedBy=default.target
