[Unit]
Description=Hourly Doors user-space update trigger (mise tools, Flatpaks, AppImages)
Documentation=https://github.com/mheci/doors

[Timer]
# User-space tooling never needs a reboot, so it tracks upstream releases
# hourly. The host image itself is staged only by the weekly system timer.
OnBootSec=5min
OnUnitActiveSec=1h
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
