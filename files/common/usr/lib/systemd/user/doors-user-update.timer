[Unit]
Description=Weekly per-user Doors update check (does not install)
Documentation=https://github.com/mheci/doors

[Timer]
# Sunday 04:45 local, after the host check. Persistent catches a machine that
# was off; it does not repeat on every boot.
OnCalendar=Sun *-*-* 04:45:00
Persistent=true
RandomizedDelaySec=30min

[Install]
WantedBy=timers.target
