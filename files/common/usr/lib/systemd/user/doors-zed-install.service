[Unit]
Description=Install the reviewed Zed build for this account
Documentation=https://github.com/mheci/doors
ConditionUser=!@system
# A finished install is skipped. The weekly check reports a newer build and
# does not download it.
ConditionPathExists=!%S/doors/zed-installed

[Service]
Type=oneshot
ExecStart=/usr/libexec/doors/zed-install.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h

[Install]
WantedBy=default.target
