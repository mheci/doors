[brave-origin]
name=Brave Origin RPM repository
baseurl=https://brave-browser-rpm-release.s3.brave.com/$basearch
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-brave
repo_gpgcheck=1
skip_if_unavailable=False
metadata_expire=6h
# Restrict this external source to Origin and its signed keyring dependency.
includepkgs=brave-origin brave-keyring
