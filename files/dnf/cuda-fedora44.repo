[cuda-fedora44-x86_64]
name=NVIDIA CUDA Toolkit for Fedora 44 x86_64
baseurl=https://developer.download.nvidia.com/compute/cuda/repos/fedora44/x86_64
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-nvidia-cuda
repo_gpgcheck=1
skip_if_unavailable=False
metadata_expire=6h
# Doors uses the toolkit-only meta package with the BlueBuild NVIDIA Open base.
# Never allow this repository to replace the base-owned driver/userspace path.
excludepkgs=cuda-drivers* nvidia-driver* nvidia-modprobe* nvidia-persistenced* nvidia-settings* nvidia-libXNVCtrl* nvidia-xconfig*
