[terra]
name=Terra $releasever
metalink=https://tetsudou.fyralabs.com/metalink?repo=terra$releasever&arch=$basearch
metadata_expire=6h
type=rpm
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-terra$releasever
repo_gpgcheck=1
enabled=1
enabled_metadata=1
skip_if_unavailable=False
# Keep the Faugus launcher on its explicitly approved project COPR route.
# Its dependencies continue to resolve from the signed Fedora/Terra repositories.
excludepkgs=faugus-launcher
priority=150
