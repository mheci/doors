# Doors Kinoite defaults use only upstream KDE Breeze assets. Values in a
# user's ~/.config/kdeglobals remain authoritative and can override these.
[KDE]
LookAndFeelPackage=org.kde.breezedark.desktop
widgetStyle=Breeze

[General]
ColorScheme=BreezeDark

[Icons]
Theme=breeze-dark

# Disable KDE Get Hot New Stuff by default at the immutable system policy layer.
[KDE Action Restrictions][$i]
ghns=false
