[cuda-fedora44-x86_64]
name=NVIDIA CUDA for Fedora 44 x86_64
baseurl=https://developer.download.nvidia.com/compute/cuda/repos/fedora44/x86_64
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-NVIDIA-CUDA
repo_gpgcheck=1
skip_if_unavailable=False
metadata_expire=6h
# The host image owns the kernel driver. This Distrobox may install only CUDA
# toolkit/user-space dependencies and must never replace the host driver path.
exclude=nvidia-driver nvidia-driver-cuda nvidia-modprobe nvidia-persistenced nvidia-settings nvidia-container-toolkit
