{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "automerge": true,
  "automergeType": "branch",
  "platformAutomerge": true,
  "regexManagers": [
    {
      "fileMatch": ["^recipes/.*\\.yml$"],
      "matchStrings": [
        "base-image:\\s+(?<depName>ghcr\\.io/[a-zA-Z0-9_\\-/.]+|quay\\.io/[a-zA-Z0-9_\\-/.]+)[\\s\\S]*?image-version:\\s+(?<currentValue>[0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "{{{depName}}}"
    },
    {
      "fileMatch": ["^recipes/ai\\.yml$"],
      "matchStrings": [
        "pi-coding-agent@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "@earendil-works/pi-coding-agent"
    },
    {
      "fileMatch": ["^files/scripts/install-opencode\\.sh$"],
      "matchStrings": [
        "OPENCODE_VERSION:-(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "sst/opencode"
    },
    {
      "fileMatch": ["^files/scripts/build-llama-cpp\\.sh$"],
      "matchStrings": [
        "LLAMA_VERSION:-(?<currentValue>[0-9]+)"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "ggml-org/llama.cpp"
    },
    {
      "fileMatch": ["^files/scripts/install-lemurs\\.sh$"],
      "matchStrings": [
        "LEMURS_VERSION:-(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "coastalwhite/lemurs"
    }
  ],
  "packageRules": [
    {
      "description": "Base-image major bumps (Fedora 44 -> 45) require manual review",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["needs-review", "base-major"]
    },
    {
      "description": "Everything else (digests, tags, tools) auto-merges",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    }
  ]
}
